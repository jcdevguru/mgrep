#!/usr/bin/env bash

# this utility finds text files under the current directory
# that each contain occurrences of multiple strings

# Flags with '+' are processed by this script
# Flags with '-' are passed to egrep (or whatever matcher is provided)

# Toggle options (lowercase = ON, uppercase = OFF):

# +d, +D: turn on and off debug messages (default: off)
# +s, +S: show or do not show matching strings (default: off)
# +g, +G: use git ls-files for starting paths if available (default: on)
# +h: show help and exit
# +n, +N: dry run or do not dry run (default: off)
# +i=cmd: initialize options with cmd (default: none)
# +c, +C: load or do not load configuration files (default: load)
# +z, +Z: use NUL-delimited or human-readable final output (default: human-readable)
# ++: stop processing gper options

# Filter options may be specified multiple times, in any combination.
#
#   +xd=pat1[,pat2,...]: ignore directories whose names match pat1 or pat2 (default: none)
#   +od=pat1[,pat2,...]: search only in hierarchy under directory with name that matches pat1 or pat2 (default: none)
#   +xf=pat1[,pat2,...]: ignore plain files whose names match pat1 or pat2 (default: none)
#   +of=pat1[,pat2,...]: search plain files only with names that match pat1 or pat2 (default: none)
# +xd, +od, +xf, and +of accept multiple values in comma-separated lists.
# +ixd, +iod, +ixf, and +iof accept values literally, without processing commas.


# Defaults

# Use egrep to match strings in files
matcher=egrep

# Do not show matched results, just files
show=0

# Support only Git-tracked files (if applicable)
git_only=1

# Do not debug or dry-run
debug=0
dry_run=0

# Load configuration files and use human-readable output
load_config=1
null_output=0

declare -a xf xd of od
default_init=init_gper
init="$default_init"

function array_contains()
{
  local needle="$1"
  shift
  local item

  for item in "$@"
  do
    if [[ "$item" == "$needle" ]]
    then
      return 0
    fi
  done

  return 1
}

function split_commas()
{
  local value="$1"
  local item
  split_values=()

  while [[ "$value" == *,* ]]
  do
    item="${value%%,*}"
    split_values+=("$item")
    value="${value#*,}"
  done

  split_values+=("$value")
}

function usage()
{
  cat <<'EOF'
Usage: gper [gper-options] [matcher-options] pattern ...

Find files that contain every pattern. Matcher options beginning with "-"
apply to the pattern that follows them.

Gper options:
  +d, +D             Turn debug messages on or off
  +s, +S             Show matching lines or filenames only
  +g, +G             Use or bypass "git ls-files" when available
  +h                 Show this help and exit
  +n, +N             Turn dry-run mode on or off
  +i=cmd             Initialize options with a configured function
  +c, +C             Load or do not load .gper configuration files
  +z, +Z             Use NUL-delimited or human-readable final output
  +xd=patterns       Exclude directories by comma-separated name patterns
  +od=patterns       Search only directories matching comma-separated patterns
  +xf=patterns       Exclude files by comma-separated name patterns
  +of=patterns       Search only files matching comma-separated name patterns
  +ixd=pattern       Exclude directories by one literal argument
  +iod=pattern       Search only directories matching one literal argument
  +ixf=pattern       Exclude files by one literal argument
  +iof=pattern       Search only files matching one literal argument
  +m=cmd             Use cmd as the matcher
  ++                 Stop processing gper options

Examples:
  gper -w lodash -i reduce
  gper +s -w lodash -i reduce
  gper +C +z -F needle
  gper +s ++ -F +leading
EOF
}

# Help and configuration control must be recognized before configuration files
# are sourced. As with normal gper option processing, stop at "++" or the first
# argument that does not begin with "+".
show_help=0
for a in "$@"
do
  case "$a" in
    ++) break ;;
    +h) show_help=1 ;;
    +c) load_config=1 ;;
    +C) load_config=0 ;;
    +*) continue ;;
    *)  break ;;
  esac
done

if (( $show_help == 1 ))
then
  usage
  exit 0
fi

# Process option file, if exists
# Get functions defined now
before_funcs=()
while IFS= read -r func
do
  before_funcs+=("$func")
done < <(compgen -A function)

if (( $load_config == 1 ))
then
  option_files=("$HOME/.gper" ".gper")
  for option_file in "${option_files[@]}"
  do
    if [[ -f "$option_file" ]]
    then
      . "$option_file"
    fi
  done
fi

# Now we see what new functions came in and make a list
# of ones that are OK for init
after_funcs=()
while IFS= read -r func
do
  after_funcs+=("$func")
done < <(compgen -A function)

init_funcs=()
for func in "${after_funcs[@]}"
do
  if ! array_contains "$func" "${before_funcs[@]}"
  then
    init_funcs+=("$func")
  fi
done

# Process init & debug flags first
for a in "$@"
do
  case "$a" in
    ++)    break ;;
    +i=*) init="${a#+i=}" ;;
    +d)   debug=1 ;;
    +D)   debug=$dry_run ;;
    +n)   dry_run=1; debug=1 ;;
    +N)   dry_run=0 ;;
    +[cCh]) ;;
    +*)   continue ;;
    *)    break;
  esac
done

if [[ $debug == 1 ]]
then
  function dlog()
  {
    type="$1"
    shift
    echo -E "DEBUG [$type]: $*" >&2 
    return 0
  }
else
  function dlog() 
  {
    return 0
  }
fi

if [[ "$init" != "" ]]
then
  if array_contains "$init" "${init_funcs[@]}"
  then
    dlog options "initializing with function '$init'"
    "$init"
  else
    dlog options "initialization function '$init' does not exist - skipping"
    if [[ $init != $default_init ]]
    then
      echo >&2 "$0: specified init function '$init' does not exist - exiting"
      exit 1
    fi
  fi
fi

# Now process flags
while [[ "$1" == +* ]]
do
  case "$1" in
    ++)    shift; break ;;
    +s)    show=1 ;;
    +S)    show=0 ;;
    +g)    git_only=1 ;;
    +G)    git_only=0 ;;
    +c)    load_config=1 ;;
    +C)    load_config=0 ;;
    +h)    ;;
    +m=*)  matcher="${1#+m=}" ;;
    +z)    null_output=1 ;;
    +Z)    null_output=0 ;;
    +xf=*) split_commas "${1#+xf=}"; xf+=("${split_values[@]}") ;;
    +xd=*) split_commas "${1#+xd=}"; xd+=("${split_values[@]}") ;;
    +of=*) split_commas "${1#+of=}"; of+=("${split_values[@]}") ;;
    +od=*) split_commas "${1#+od=}"; od+=("${split_values[@]}") ;;
    +ixf=*) xf+=("${1#+ixf=}") ;;
    +ixd=*) xd+=("${1#+ixd=}") ;;
    +iof=*) of+=("${1#+iof=}") ;;
    +iod=*) od+=("${1#+iod=}") ;;
    +[dDnN]|+i=*) ;;
    *) echo >&2 "$0: unknown flag '$1'"; exit 1;;
  esac

  shift
done

if [ $# -eq 0 ]
then
  echo >&2 "$0: at least one pattern required"
  exit 1
fi

if [[ "${!#}" == -* ]]
then
  echo >&2 "$0: last argument must be a pattern, not a flag"
  exit 1
fi

# Now remove all elements from "xd" & "xf" (exclude dirs, files)
# that appear in "od", "of" (only dirs, only files)

filtered=()
for item in "${xd[@]}"
do
  if ! array_contains "$item" "${od[@]}"
  then
    filtered+=("$item")
  fi
done
xd=("${filtered[@]}")

filtered=()
for item in "${xf[@]}"
do
  if ! array_contains "$item" "${of[@]}"
  then
    filtered+=("$item")
  fi
done
xf=("${filtered[@]}")

dlog options \
  debug="$debug"\
  dry_run="$dry_run"\
  git_only="$git_only"\
  load_config="$load_config"\
  null_output="$null_output"\
  show="$show"\
  xf="(${xf[@]})"\
  of="(${of[@]})"\
  xd="(${xd[@]})"\
  od="(${od[@]})"\
  init="'$init'"

function find_args()
{
  flag="$1"
  prefix="$2"
  suffix="$3"
  shift 3

  local args=""
  local quoted
  for a in "$@"
  do
    if [[ "$a" == '' ]]
    then
      continue 
    fi

    if [[ "$args" != "" ]]
    then
      args+=" -o "
    fi

    quoted=$(quote_pattern "$prefix$a$suffix")
    args+="-$flag $quoted"
  done
  echo "$args"
}

function find_name_args() {
  find_args name "" "" "$@"
}

function find_path_args() {
  find_args path '*/' '/*' "$@"
}

function quote_pattern() {
  printf '%q' "$1"
}

function quote_patterns() {
  local arr=("$@")
  local rc=()

  for p in "${arr[@]}"; do
    rc+=("$(quote_pattern "$p")")
  done

  printf "%s " "${rc[@]}"
  printf "\n"
}

function extract_flags()
{
  local start=$1
  shift
  local v=("$@")
  local next=$start
  local sp

  while (( next < ${#v[@]} ))
  do
    if [[ "${v[$next]}" != -* ]]
    then
      break
    fi
    printf "%s%s" "$sp" "${v[$next]}"
    next=$((next + 1))
    sp=" "
  done

  return $next
}

filter_paths() {
  local mode="$1"
  shift
  local patterns=("$@")
  
  while IFS= read -r -d '' filepath
  do
    local match=0
    case "$mode" in
      of|xf)
        filename=${filepath##*/}
        for pattern in "${patterns[@]}"
        do
          if [[ "$filename" == $pattern ]]
          then
            match=1
            break
          fi
        done
        ;;
      od|xd)
        for pattern in "${patterns[@]}"
        do
          if [[ "$filepath" == */$pattern/* || "$filepath" == $pattern/* ]]
          then
            match=1
            break
          fi
        done
        ;;
    esac
    
    # flip match value based on whether or not we are excluding
    [[ "$mode" == x[df] ]] && match=$((1-match))
    [[ $match -eq 1 ]] && printf "%s\0" "$filepath"
  done
}
  

function gen_match()
{
  local pat="$1"
  local first="$2"
  local last=$3
  local show="$4"
  local null_output="$5"
  shift 5
  local opts="$@"
  local zero_opt=""
  local first_opt=""
  local file_opt=""

  if (( $first == 1 ))
  then
    first_opt="--binary-files=without-match"
  fi

  if (( $show == 1 ))
  then
    # always include file names when showing
    file_opt=-H
    if (( $null_output == 1 ))
    then
      zero_opt=--null
    fi
  else
    file_opt=--files-with-matches
    if (( $last == 0 || $null_output == 1 ))
    then
      zero_opt=--null
    fi
  fi

  printf '%s\n' \
    "xargs -0 $matcher $first_opt $zero_opt $file_opt $opts $(quote_pattern "$pat")"
  return 0
}

# Take action based on whether we are in a directory managed by git
if [[ $git_only == 1 ]]
then
  if command -v git >/dev/null 2>&1
  then
    if git -C . rev-parse 2>/dev/null
    then
      git check-ignore -q . 2>/dev/null
      if [[ $? == 0 ]]
      then
        # No files would be matched since the current directory is ignored so
        # we have to turn off Git-only file selection
        dlog process "not using git to list files (current directory ignored by git)"
        git_only=0
      else
        dlog process "using git to list files (directory in git)"
      fi
    else
      dlog process "not using git to list files (directory not in git project)"
      git_only=0
    fi
  else
    dlog process "not using git to list files (git not in command environment)"
    git_only=0
  fi
fi

# xd: +xd=node_modules +xd=logs 
#     find . \( -type d \( -name node_modules -o -name logs \) ! -name . -prune \) -o -type f -print
#
# od: +od=src
#     find . \( -path '*/src/*' -type f -print

if [[ $git_only == 1 ]]
then
  command="git ls-files -z ."
  
  # Apply directory exclusions
  if (( ${#xd[@]} > 0 )); then
    command+=" | filter_paths xd $(quote_patterns "${xd[@]}")"
  fi
  
  # Apply directory exclusives
  if (( ${#od[@]} > 0 )); then
    command+=" | filter_paths od $(quote_patterns "${od[@]}")"
  fi
  
  # Apply file filtering
  if (( ${#of[@]} > 0 )); then
    command+=" | filter_paths of $(quote_patterns "${of[@]}")"
  fi

  if (( ${#xf[@]} > 0 )); then
    command+=" | filter_paths xf $(quote_patterns "${xf[@]}")"
  fi
  
else
  command="find ."

  exclude_dirs=$(find_name_args "${xd[@]}")

  if [[ "$exclude_dirs" != "" ]]
  then
    command+=" \( -type d \( $exclude_dirs \) ! -name . -prune \) -o"
  fi

  command+=" -type f" 

  exclude_files=$(find_name_args "${xf[@]}")
  only_files=$(find_name_args "${of[@]}")
  only_paths=$(find_path_args "${od[@]}")

  if [[ "$only_paths" != "" ]]
  then
    command+=" \( $only_paths \)"
  fi
  
  if [[ "$only_files" != "" ]]
  then
    command+=" \( $only_files \)"
  fi

  if [[ "$exclude_files" != "" ]]
  then
    command+=" ! \( $exclude_files \)"
  fi

  command+=" -print0"
fi

# Now construct command line by iterating per pattern
arg_idx=0
args=("$@")
pat="${args[$arg_idx]}"
arg_count=${#args[@]}

while (( $arg_idx < $arg_count ))
do
    match_options=$(extract_flags "$arg_idx" "${args[@]}")
    arg_idx=$?

    pat="${args[$arg_idx]}"

    show_arg=0
    is_last=$((arg_idx == arg_count - 1))
    is_first=$((arg_idx == 0))
    if (( $show == 1 ))
    then
      if (($arg_count == 1))
      then
        show_arg=1
      else
        is_last=0
      fi
    fi

    command="${command} | "$(gen_match \
      "$pat" "$is_first" "$is_last" "$show_arg" "$null_output" "$match_options")
    arg_idx=$((arg_idx + 1))
done

if (( $show == 0 || $arg_count == 1 ))
then
  dlog execute command = "[$command]"
  if (( $dry_run == 0 ))
  then
    eval "$command"
  fi
else
  match_data_file=/tmp/gper-$$.tmp
  trap 'rm -f $match_data_file; exit 1' 1 2 5 15

  cmd="$command > $match_data_file"
  dlog execute command = "[$cmd]"
  if (( $dry_run == 0 ))
  then
    eval "$cmd"
  fi
  arg_idx=0
  while (( $arg_idx < $arg_count ))
  do
    match_options=$(extract_flags "$arg_idx" "${args[@]}")
    arg_idx=$?

    pat="${args[$arg_idx]}"


    cmd="$(gen_match "$pat" 0 1 1 "$null_output" "$match_options") < $match_data_file"
    dlog execute command = "[$cmd]"
    if (( $dry_run == 0 ))
    then
      eval "$cmd"
    fi
    arg_idx=$((arg_idx + 1))
  done
  rm -f $match_data_file
fi
exit $?
