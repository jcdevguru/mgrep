#!/usr/bin/env bash

FAIL_CNT=0
TEST_DIR=$(
  cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null || exit 1
  pwd -P
) || exit 1
GPER="$TEST_DIR/../gper"
EXAMPLE_CONFIG="$TEST_DIR/../dot-gper.example.bash"
INPUT_DIR="$TEST_DIR/input"
BASELINE_DIR="$TEST_DIR/baseline"
TEST_HOME=$(mktemp -d "${TMPDIR:-/tmp}/gper-test-home.XXXXXX") || exit 1
trap 'rm -rf -- "$TEST_HOME"' EXIT HUP INT TERM

function run_test()
{
  local baseline_root="$1"
	local desc="$2"
	local expected_status=$3
	shift 3

	local rc=0
	local actual=''
	
	actual="$(HOME="$TEST_HOME" "$GPER" "$@" 2>/dev/null)"
	local st=$?
	if [[ $st != $expected_status ]]
	then
		echo "$desc: FAIL - expected exit status $expected_status, got $st"
		rc=1
	elif [[ "$baseline_root" != "-" ]]
  then
    local baseline_file="${baseline_root}.txt"
    local baseline_path="$BASELINE_DIR/$baseline_file"
    local expected=$(cat "$baseline_path")
    if [[ "$actual" != "$expected" ]]
    then
      echo "${desc}: FAIL - actual != contents of '$baseline_file'"
      diff "$baseline_path" <(echo "$actual")
      rc=1
    fi
  fi
    
  if [[ $rc == 0 ]]
  then
    echo "$desc": OK
  else
    FAIL_CNT=$((FAIL_CNT+1))
  fi

	return $rc
}

function run_null_test()
{
  local baseline_root="$1"
  local desc="$2"
  local expected_status=$3
  local baseline_mode="$4"
  shift 4

  local baseline_path="$BASELINE_DIR/${baseline_root}.txt"
  local actual_path=$(mktemp "${TMPDIR:-/tmp}/gper-test-actual.XXXXXX")
  local expected_path=$(mktemp "${TMPDIR:-/tmp}/gper-test-expected.XXXXXX")
  local rc=0

  HOME="$TEST_HOME" "$GPER" "$@" > "$actual_path" 2>/dev/null
  local st=$?

  case "$baseline_mode" in
    filenames)
      tr '\n' '\0' < "$baseline_path" > "$expected_path"
      ;;
    matches)
      while IFS=: read -r filename match
      do
        printf '%s\0%s\n' "$filename" "$match"
      done < "$baseline_path" > "$expected_path"
      ;;
    *)
      echo "$desc: FAIL - unknown baseline mode '$baseline_mode'"
      rc=1
      ;;
  esac

  if [[ $st != $expected_status ]]
  then
    echo "$desc: FAIL - expected exit status $expected_status, got $st"
    rc=1
  elif [[ $rc == 0 ]] && ! cmp -s "$expected_path" "$actual_path"
  then
    echo "$desc: FAIL - byte output does not match '$baseline_path'"
    echo "expected:"
    od -An -tx1c "$expected_path"
    echo "actual:"
    od -An -tx1c "$actual_path"
    rc=1
  fi

  rm -f "$actual_path" "$expected_path"

  if [[ $rc == 0 ]]
  then
    echo "$desc": OK
  else
    FAIL_CNT=$((FAIL_CNT+1))
  fi

  return $rc
}

cd "$INPUT_DIR" >/dev/null ||
  { echo >&2 "missing directory '$INPUT_DIR' - exiting"; exit 1; }

# Unless otherwise noted, all files must be tracked by Git
# since gper uses Git to list files by default

## Usage errors
run_test - "Usage - no arguments (error)" 1
run_test - "Usage - end with gper flag (error)" 1 +s 
run_test - "Usage - end with egrep flag (error)" 1 -i
run_test - "Usage - unknown flag (error)" 1 "+@" 
run_test - "Usage - end with gper option terminator (error)" 1 ++
run_test u01 "Usage - ++ permits pattern beginning with +" 0 +s ++ -F +leading
run_test h01 "Usage - show help" 0 +h

## Configuration

echo 'echo CONFIG-SOURCED; matcher=false' > "$TEST_HOME/.gper"
run_test - "Config - load configuration by default" 1 hello
run_test b02 "Config - +C skips configuration" 0 +C hello
run_test - "Config - +c restores configuration loading" 1 +C +c hello
run_test h01 "Config - help does not load configuration" 0 +h
rm -f "$TEST_HOME/.gper"

echo 'exclude_hello() { xf+=("01.txt"); }' > "$TEST_HOME/.gper"
run_test - "Config - Bash init function updates an array" 1 +i=exclude_hello hello
rm -f "$TEST_HOME/.gper"

if (
  source "$EXAMPLE_CONFIG"
  xd=()
  ignore_node_modules
  [[ ${#xd[@]} -eq 1 && "${xd[0]}" == node_modules ]] || exit 1

  xd=()
  git_only=1
  code
  [[ $git_only -eq 0 ]]
)
then
  echo "Config - example uses node_modules and git_only: OK"
else
  echo "Config - example uses node_modules and git_only: FAIL"
  FAIL_CNT=$((FAIL_CNT+1))
fi

## Output format

run_null_test b03 "Flag - NUL-delimited filenames" 0 filenames +z cases
run_null_test s03 "Flag - NUL-delimited filename with matches and spaces" 0 matches +s +z spacey
run_test b03 "Flag - +Z restores human-readable output" 0 +z +Z cases

## Filter tests

# Filter by file names
run_test f01 "Flag - only .txt files" 0 +of='*.txt' string
run_test f02 "Flag - no .txt files" 0 +xf='*.txt' string
run_test b02 "Flag - only file overrides identical exclusion" 0 +xf=01.txt +of=01.txt hello
run_test r01 "Flag - raw file filter preserves spaces" 0 +G +iof='a b c.txt' spacey

# Filter by directory names
run_test d01 "Flag - only 'subdir' directory" 0 +od='subdir' string
run_test d02 "Flag - exclude 'subdir' directory" 0 +xd='subdir' string
run_test d01 "Flag - only directory overrides identical exclusion" 0 +xd=subdir +od=subdir string
run_test r02 "Flag - raw directory filter" 0 +G +od=subdir content

# Filter by Git-tracked files
ngpfx="nongit"
pid=$$
(
  FAIL_CNT=0
  ngfile="${ngpfx}-${pid}.txt"
  srch="remove me: ${pid}"

  rm -f -- "$ngfile"
  trap 'rm -f -- "$ngfile"; exit 1' HUP INT QUIT TERM
  echo "$srch" > "$ngfile"

  run_test - "Flag - use Git to list files (no match)" 1 +g "$srch"
  run_test - "Flag - do not use Git to list files (match)" 0 +G "$srch"

  echo 'init_gper() { git_only=0; }' > "$TEST_HOME/.gper"
  run_test - "Config - git_only=0 searches untracked files" 0 "$srch"
  rm -f "$TEST_HOME/.gper"

  rm -f -- "$ngfile"
  exit $((FAIL_CNT > 0))
)
if [[ $? -ne 0 ]]
then
  FAIL_CNT=$((FAIL_CNT+1))
fi

# Basic
run_test b01 "Basic - 1 string, no matches (1 exit status)" 1 NOTHING
run_test b02 "Basic - 1 string, 1 file" 0 hello
run_test b03 "Basic - 1 string, >1 file" 0 cases
run_test b04 "Basic - 1 string, 1 file (case-sensitive default)" 0 Case
run_test b05 "Basic - 1 string, >1 file (case-insensitive match with flag)" 0 -i Case
run_test b06 "Basic - 1 string, 1 file, show matches" 0 +s MIXED

# Simple
run_test s01 "Simple - 2 strings in 1 file, separate lines" 0 lower cases
run_test s02 "Simple - filename with spaces" 0 spacey
run_test s03 "Simple - filename with spaces, show matches" 0 +s spacey
run_test s04 "Simple - 1 string, +1 file, show matches (case insensitive)" 0 +s -i cases

# Moderate
run_test m01 "Moderate - 2 strings, +1 file, show matches (case sensitive)" 0 +s "case" string

echo "Tests complete. Error count = $FAIL_CNT"
exit $((FAIL_CNT > 0))
